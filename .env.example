# 이 파일을 .env 로 복사한 뒤 키를 채우세요. (.env 는 git 에 올라가지 않습니다)
GEMINI_API_KEY=         # 크롤러 비전 분석 + GEO Q&A·키워드 생성 (crawler-py/pdp_pipeline.py, geo_gen.py)
FIRECRAWL_API_KEY=      # 크롤러 마크다운/HTML 수집
# 선택
PORT=3001
CLIA_API_TOKEN=         # 지정하면 /api/v1/* 호출에 Bearer 토큰 필요
CRAWLER_PYTHON=         # 크롤러 Python 경로 강제 지정 (기본: crawler-py/.venv/bin/python → python3)
CRAWLER_FULL_AI=        # 1 이면 모든 크롤을 기존 방식(스크린샷 + Gemini 분석·시각 QA, 10~15분)으로 실행. 기본은 HTML 컴포넌트 빠른 경로
# 크롤링 결과 보관용 S3 호환 버킷 (Railway Bucket 등) — 없으면 로컬 폴더만 사용. DEPLOY.md 4장
BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
ENDPOINT=               # Railway: https://t3.storageapi.dev
REGION=                 # Railway: auto
S3_FORCE_PATH_STYLE=    # path-style 버킷이면 1
