# 이 파일을 .env 로 복사한 뒤 키를 채우세요. (.env 는 git 에 올라가지 않습니다)
GEMINI_API_KEY=         # 크롤러 비전 분석 + GEO Q&A·키워드 생성 (crawler-py/pdp_pipeline.py, geo_gen.py)
FIRECRAWL_API_KEY=      # 크롤러 마크다운/HTML 수집
# 선택
PORT=3001
CLIA_API_TOKEN=         # 지정하면 /api/v1/* 호출에 Bearer 토큰 필요
CRAWLER_PYTHON=         # 크롤러 Python 경로 강제 지정 (기본: crawler-py/.venv/bin/python → python3)
